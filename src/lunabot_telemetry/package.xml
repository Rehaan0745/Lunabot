<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.ros.org/XMLSchema/package_format3.xsd"?>
<package format="3">
  <name>lunabot_telemetry</name>
  <version>1.0.0</version>
  <description>ROS 2 telemetry bridge node for the Lunabot rover sensors and motors</description>
  <maintainer email="developer@example.com">Lunabot Developer</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-serial</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
